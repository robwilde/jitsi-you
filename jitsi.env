# shellcheck disable=SC2034
################################################################################
# Konvoy team Jitsi Meet — v1 (.env)
#
# Copy this file to the docker-jitsi-meet release folder as ".env", then run
# ./gen-passwords.sh to fill the Security section.
#
# REPLACE before use:
#   meet.example.com   -> your real hostname
#   you@example.com    -> your email (Let's Encrypt expiry notices)
#   192.168.1.50       -> the server's LAN IP
#   203.0.113.10       -> your static public IP
################################################################################

#
# Basic
#
CONFIG=~/.jitsi-meet-cfg
HTTP_PORT=80
HTTPS_PORT=443
TZ=Australia/Brisbane
PUBLIC_URL=https://meet.example.com

# Split-horizon: LAN IP first, then public IP. Same-LAN peers connect direct,
# remote peers via the port-forward. Wrong/missing value = "works with 2, dies with 3".
JVB_ADVERTISE_IPS=192.168.1.50,203.0.113.10

# JVB knows both of its own IPs from the line above, so it does not need to
# STUN-discover them. Removes a boot-time dependency on Jitsi's public STUN
# relay (JVB_STUN_SERVERS defaults to meet-jit-si-turnrelay.jitsi.net:443).
JVB_DISABLE_STUN=1

#
# Media & bandwidth  (guide §7)
#
# These are the container defaults stated explicitly — they are the knobs to
# turn if upload saturates. Drop RESOLUTION to 360 (and RESOLUTION_WIDTH to
# 640) if §7 shows the link is the bottleneck. Requires down && up, not restart.
ENABLE_P2P=1
RESOLUTION=720
RESOLUTION_MIN=180
RESOLUTION_WIDTH=1280
RESOLUTION_WIDTH_MIN=320

# JVB's Colibri REST stats. OFF by default in the image (jvb.conf:
# COLIBRI_REST_ENABLED | default "false"), which makes the §7 bandwidth
# measurement return nothing. Compose binds it to 127.0.0.1:8080 only, so this
# is not publicly reachable.
COLIBRI_REST_ENABLED=1

#
# Let's Encrypt
#
ENABLE_LETSENCRYPT=1
LETSENCRYPT_DOMAIN=meet.example.com
LETSENCRYPT_EMAIL=you@example.com
# Default ACME server in the image is ZeroSSL; force Let's Encrypt.
LETSENCRYPT_ACME_SERVER="letsencrypt"
# First boot ONLY: leave staging on until the container gets a cert cleanly,
# then set to 0, delete ~/.jitsi-meet-cfg/storage/web/* (that is where acme.sh
# and the issued certs live) and do a full down && up.
# (LE rate limit: 5 duplicate certs per domain per 7 days.)
LETSENCRYPT_USE_STAGING=1
ENABLE_HTTP_REDIRECT=1
ENABLE_HSTS=1

#
# Authentication — the 3 of you log in; nobody else gets in
#
ENABLE_AUTH=1
ENABLE_GUESTS=0
AUTH_TYPE=internal
ENABLE_AUTO_LOGIN=1
JICOFO_AUTH_LIFETIME=24 hours

#
# UX defaults
#
ENABLE_PREJOIN_PAGE=1
ENABLE_WELCOME_PAGE=1
ENABLE_LOBBY=1
ENABLE_BREAKOUT_ROOMS=0
ENABLE_RECORDING=0
START_WITH_AUDIO_MUTED=0
START_WITH_VIDEO_MUTED=0
ENABLE_NOISY_MIC_DETECTION=1

#
# Memory limits for Java components (3 users — keep them small)
#
JICOFO_MAX_MEMORY=512m
VIDEOBRIDGE_MAX_MEMORY=1024m

#
# Security — ./gen-passwords.sh fills these. Containers refuse to start if empty.
#
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=

#
# Docker Compose
#
RESTART_POLICY=unless-stopped

# Compose defaults the image tag to the release you unzipped (JITSI_IMAGE_VERSION
# is unset -> e.g. stable-11146-2). Uncomment to pin explicitly so an
# unzip-over-the-top upgrade is a deliberate change, not a surprise.
#JITSI_IMAGE_VERSION=stable-11146-2
